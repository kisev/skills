{
  "$schema": "./team-context.schema.json",
  "schema_version": 1,
  "profile": "example-team",
  "team": {
    "name": "Example Platform Team",
    "description": "Maintains shared delivery tooling.",
    "members": [
      {
        "id": "alice",
        "display_name": "Alice Example",
        "role": "lead",
        "groups": ["platform"],
        "active": true
      }
    ],
    "external_contributors": {
      "policy": "An author outside included_groups is external.",
      "included_groups": ["platform"]
    }
  },
  "projects": [
    {
      "key": "service-template",
      "name": "Service Template",
      "id": 101,
      "path": "platform/templates/service",
      "category": "Core",
      "description": "Template for new services.",
      "owner_group": "platform",
      "include": true
    }
  ],
  "technologies": ["GitLab CI", "Kubernetes", "Helm"],
  "goals": [
    {
      "id": "GOAL-1",
      "title": "Reduce delivery lead time",
      "status": "in-progress",
      "source": "ROADMAP.md"
    }
  ],
  "cadence": {
    "timezone": "UTC",
    "sprint": "two weeks",
    "retro": "monthly",
    "roadmap": "quarterly"
  },
  "baseline": {
    "description": "The current roadmap and recent delivery reports are authoritative.",
    "references": [
      {
        "kind": "file",
        "location": "ROADMAP.md",
        "purpose": "Current goals and historical plans"
      }
    ]
  },
  "delivery_signals": [
    {
      "name": "merged-merge-request",
      "source": "gitlab",
      "state": "merged",
      "timestamp": "merged_at"
    },
    {
      "name": "release",
      "source": "gitlab",
      "state": "released",
      "timestamp": "released_at"
    }
  ],
  "sources": [
    {
      "name": "gitlab",
      "kind": "gitlab",
      "tool": "glab",
      "location": "gitlab.example.test",
      "purpose": "Merge requests, issues, releases, and tags"
    }
  ],
  "actions": {
    "planning": {
      "rules": ["Prepare scope without creating external work items."]
    },
    "sprint-close": {
      "rules": ["Close only against fresh delivery evidence."]
    },
    "retro": {
      "output": {
        "format": "marp",
        "target_pattern": "src/{date}-team-retro/presentation.md",
        "verification_command": "task build:{presentation-name}"
      },
      "project_detail_threshold": 3,
      "required_sections": ["title", "summary", "projects", "plans", "thanks"],
      "rules": ["Describe each change as outcome and purpose."],
      "use_gitlab_metrics": true
    },
    "roadmap": {
      "document": "ROADMAP.md",
      "period": "quarterly",
      "history_policy": "Preserve past plans; update factual outcomes only.",
      "status_legend": {
        "completed": "completed",
        "partial": "in progress",
        "not-started": "not started",
        "blocked": "blocked by an external dependency"
      },
      "rules": ["Give every unfinished goal an explicit destination."],
      "verification_commands": ["markdownlint-cli2 ROADMAP.md"],
      "use_gitlab_metrics": true
    },
    "slides-prompts": {
      "input_pattern": "presentation.md",
      "output_pattern": "assets/{NN}.md",
      "image_pattern": "assets/{NN}.png",
      "default_theme": "technical editorial illustration",
      "default_style": "dark flat digital art",
      "theme_library": [
        {
          "name": "thematic-story",
          "description": "A selected book, world, or topic provides the visual language.",
          "style": "Use the selected theme's atmosphere and recognizable motifs.",
          "integration": "Embed factual team tools and delivery ideas as restrained parts of the themed world.",
          "constraints": ["Do not produce an unrelated theme illustration."]
        }
      ],
      "team_reference_policy": "Integrate concise references to the team's actual tools and work into every relevant scene.",
      "rendered_text_policy": "Only factual short technical labels when useful; never repeat the slide title.",
      "rules": ["Keep negative space for the slide text overlay."]
    }
  },
  "provenance": [
    {
      "kind": "example",
      "location": "references/team-context.example.json",
      "purpose": "Demonstrate the public profile shape",
      "reviewed_at": "2026-01-01"
    }
  ],
  "extensions": {}
}
