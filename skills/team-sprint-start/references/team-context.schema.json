{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kisev/skills/main/shared/references/team_runtime/team-context.schema.json",
  "title": "Portable team workflow profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "team",
    "projects",
    "cadence",
    "baseline",
    "delivery_signals",
    "actions"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 1 },
    "profile": { "$ref": "#/$defs/name" },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "members", "external_contributors"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/member" }
        },
        "external_contributors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "included_groups"],
          "properties": {
            "policy": { "$ref": "#/$defs/text" },
            "included_groups": { "$ref": "#/$defs/textArray" }
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/project" }
    },
    "technologies": { "$ref": "#/$defs/textArray" },
    "goals": {
      "type": "array",
      "items": { "$ref": "#/$defs/goal" }
    },
    "cadence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone"],
      "properties": {
        "timezone": { "$ref": "#/$defs/text" },
        "sprint": { "$ref": "#/$defs/text" },
        "retro": { "$ref": "#/$defs/text" },
        "roadmap": { "$ref": "#/$defs/text" }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "references"],
      "properties": {
        "description": { "$ref": "#/$defs/text" },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reference" }
        }
      }
    },
    "delivery_signals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/deliverySignal" }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "planning": { "$ref": "#/$defs/simpleAction" },
        "sprint-close": { "$ref": "#/$defs/simpleAction" },
        "retro": { "$ref": "#/$defs/retroAction" },
        "roadmap": { "$ref": "#/$defs/roadmapAction" },
        "slides-prompts": { "$ref": "#/$defs/slidesAction" }
      }
    },
    "provenance": {
      "type": "array",
      "items": { "$ref": "#/$defs/provenance" }
    },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "textArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "groups", "active"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "display_name": { "$ref": "#/$defs/text" },
        "role": { "$ref": "#/$defs/text" },
        "groups": { "$ref": "#/$defs/textArray" },
        "active": { "type": "boolean" },
        "active_from": { "$ref": "#/$defs/text" },
        "active_until": { "$ref": "#/$defs/text" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "category", "description", "include"],
      "properties": {
        "key": { "$ref": "#/$defs/text" },
        "name": { "$ref": "#/$defs/text" },
        "id": {
          "oneOf": [{ "type": "integer" }, { "$ref": "#/$defs/text" }]
        },
        "path": { "$ref": "#/$defs/text" },
        "category": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "owner_group": { "$ref": "#/$defs/text" },
        "include": { "type": "boolean" }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "title": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/text" },
        "source": { "$ref": "#/$defs/text" }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "location", "purpose"],
      "properties": {
        "kind": { "$ref": "#/$defs/text" },
        "location": { "$ref": "#/$defs/text" },
        "purpose": { "$ref": "#/$defs/text" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "location", "purpose"],
      "properties": {
        "kind": { "$ref": "#/$defs/text" },
        "location": { "$ref": "#/$defs/text" },
        "purpose": { "$ref": "#/$defs/text" },
        "reviewed_at": { "$ref": "#/$defs/text" }
      }
    },
    "deliverySignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "state", "timestamp"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "source": { "$ref": "#/$defs/text" },
        "state": { "$ref": "#/$defs/text" },
        "timestamp": { "$ref": "#/$defs/text" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "tool", "location", "purpose"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "kind": { "$ref": "#/$defs/text" },
        "tool": { "$ref": "#/$defs/text" },
        "location": { "$ref": "#/$defs/text" },
        "purpose": { "$ref": "#/$defs/text" }
      }
    },
    "simpleAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "rules": { "$ref": "#/$defs/textArray" },
        "verification_commands": { "$ref": "#/$defs/textArray" }
      }
    },
    "retroAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output", "required_sections", "rules"],
      "properties": {
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "target_pattern"],
          "properties": {
            "format": { "$ref": "#/$defs/text" },
            "target_pattern": { "$ref": "#/$defs/text" },
            "verification_command": { "$ref": "#/$defs/text" }
          }
        },
        "project_detail_threshold": { "type": "integer", "minimum": 1 },
        "required_sections": { "$ref": "#/$defs/textArray" },
        "rules": { "$ref": "#/$defs/textArray" },
        "use_gitlab_metrics": { "type": "boolean" }
      }
    },
    "roadmapAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "period", "history_policy", "rules"],
      "properties": {
        "document": { "$ref": "#/$defs/text" },
        "period": { "$ref": "#/$defs/text" },
        "history_policy": { "$ref": "#/$defs/text" },
        "status_legend": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/text" }
        },
        "rules": { "$ref": "#/$defs/textArray" },
        "verification_commands": { "$ref": "#/$defs/textArray" },
        "use_gitlab_metrics": { "type": "boolean" }
      }
    },
    "slidesAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_pattern",
        "output_pattern",
        "image_pattern",
        "team_reference_policy",
        "rules"
      ],
      "properties": {
        "input_pattern": { "$ref": "#/$defs/text" },
        "output_pattern": { "$ref": "#/$defs/text" },
        "image_pattern": { "$ref": "#/$defs/text" },
        "default_theme": { "$ref": "#/$defs/text" },
        "default_style": { "$ref": "#/$defs/text" },
        "theme_library": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/themePreset" }
        },
        "team_reference_policy": { "$ref": "#/$defs/text" },
        "rendered_text_policy": { "$ref": "#/$defs/text" },
        "rules": { "$ref": "#/$defs/textArray" }
      }
    },
    "themePreset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "style", "integration", "constraints"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/text" },
        "style": { "$ref": "#/$defs/text" },
        "integration": { "$ref": "#/$defs/text" },
        "constraints": { "$ref": "#/$defs/textArray" }
      }
    }
  }
}
