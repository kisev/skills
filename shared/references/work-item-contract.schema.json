{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kisev/skills/work-item-contract/v1",
  "title": "Normalized work item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "item_id",
    "problem",
    "outcome",
    "acceptance_criteria",
    "scope",
    "dependencies",
    "external_actions",
    "assumptions",
    "safety",
    "risks",
    "unresolved_questions",
    "stop_conditions"
  ],
  "properties": {
    "contract_version": { "const": "work-item/v1" },
    "item_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "problem": { "$ref": "#/$defs/text" },
    "outcome": { "$ref": "#/$defs/text" },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/criterion" }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_scope", "non_goals"],
      "properties": {
        "in_scope": { "$ref": "#/$defs/text_list" },
        "non_goals": { "$ref": "#/$defs/text_list" }
      }
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "external_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "assumptions": { "$ref": "#/$defs/text_list" },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraints", "operational_constraints"],
      "properties": {
        "constraints": { "$ref": "#/$defs/text_list" },
        "operational_constraints": { "$ref": "#/$defs/text_list" }
      }
    },
    "risks": {
      "type": "array",
      "items": { "$ref": "#/$defs/risk" }
    },
    "unresolved_questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/question" }
    },
    "stop_conditions": { "$ref": "#/$defs/text_list" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 16000 },
    "text_list": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "evidence", "dependencies"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "$ref": "#/$defs/text" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "status", "depends_on"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "$ref": "#/$defs/text" },
        "status": { "enum": ["available", "pending", "blocked"] },
        "depends_on": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "owner", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "$ref": "#/$defs/text" },
        "owner": { "$ref": "#/$defs/text" },
        "status": { "enum": ["planned", "confirmed", "completed", "not_applicable"] }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "probability", "impact", "mitigation"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "$ref": "#/$defs/text" },
        "probability": { "enum": ["low", "medium", "high"] },
        "impact": { "enum": ["low", "medium", "high"] },
        "mitigation": { "$ref": "#/$defs/text" }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "blocking"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "question": { "$ref": "#/$defs/text" },
        "blocking": { "type": "boolean" }
      }
    }
  }
}
