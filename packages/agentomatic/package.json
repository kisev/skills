{
  "name": "@kisev/agentomatic",
  "version": "11.0.2",
  "description": "OpenCode integration and opt-in installer for portable Agent Skills.",
  "homepage": "https://github.com/kisev/skills#readme",
  "bugs": {
    "url": "https://github.com/kisev/skills/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kisev/skills.git",
    "directory": "packages/agentomatic"
  },
  "bin": {
    "agentomatic": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins/rules-injector": {
      "types": "./dist/plugins/rules-injector.d.ts",
      "import": "./dist/plugins/rules-injector.js"
    },
    "./plugins/rtk": {
      "types": "./dist/plugins/rtk.d.ts",
      "import": "./dist/plugins/rtk.js"
    },
    "./plugins/zed-bell": {
      "types": "./dist/plugins/zed-bell.d.ts",
      "import": "./dist/plugins/zed-bell.js"
    },
    "./plugins/code-simplify": {
      "types": "./dist/plugins/code-simplify.d.ts",
      "import": "./dist/plugins/code-simplify.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc --project tsconfig.json && node dist/generate-assets.js",
    "test": "node --test test/agent-profiles.test.mjs test/code-simplify.test.mjs test/command-cli.test.mjs test/config-setup.test.mjs test/legacy-migration.test.mjs test/doctor.test.mjs test/package.test.mjs test/rtk.test.mjs test/self-install.test.mjs test/stage19.test.mjs test/surface-coverage.test.mjs test/opencode-compatibility.test.mjs",
    "smoke": "node test/smoke.mjs",
    "pack:check": "node test/pack-allowlist.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@kisev/safe-fs": "^1.0.0",
    "commander": "15.0.0",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.19",
    "@types/node": "22.15.30",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0 <2.1.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "skillsInstallerVersion": "1.7.0"
}
