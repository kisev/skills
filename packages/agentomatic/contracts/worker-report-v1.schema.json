{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kisev/skills/contracts/worker-report-v1.schema.json",
  "type": "object",
  "required": ["worker_report"],
  "properties": {
    "worker_report": {
      "type": "object",
      "required": [
        "schema_version",
        "status",
        "card_id",
        "revision",
        "changed_files",
        "checks",
        "writes_performed",
        "risks"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "status": { "enum": ["COMPLETED", "BLOCKED", "FAILED", "REJECTED_PLAN"] },
        "card_id": { "type": ["string", "null"] },
        "revision": { "type": ["integer", "null"] },
        "changed_files": { "type": "array", "items": { "type": "string" } },
        "checks": { "type": "array" },
        "writes_performed": { "type": "boolean" },
        "risks": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
