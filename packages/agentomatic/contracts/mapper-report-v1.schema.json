{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kisev/skills/contracts/mapper-report-v1.schema.json",
  "type": "object",
  "required": ["mapper_report"],
  "properties": {
    "mapper_report": {
      "type": "object",
      "required": ["schema_version", "paths", "callers", "tests", "patterns", "evidence_gaps"],
      "properties": {
        "schema_version": { "const": 1 },
        "paths": { "type": "array" },
        "callers": { "type": "array" },
        "tests": { "type": "array" },
        "patterns": { "type": "array" },
        "evidence_gaps": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
