{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kisev/skills/contracts/critic-report-v1.schema.json",
  "type": "object",
  "required": ["critic_report"],
  "properties": {
    "critic_report": {
      "type": "object",
      "required": [
        "schema_version",
        "status",
        "card_id",
        "revision",
        "findings",
        "unrun_checks",
        "risks"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "status": { "enum": ["APPROVED", "CHANGES_REQUIRED"] },
        "card_id": { "type": "string" },
        "revision": { "type": "integer", "minimum": 1 },
        "findings": { "type": "array" },
        "unrun_checks": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
