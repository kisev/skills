{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisev.dev/schemas/eval-result/v1",
  "title": "Behavioral evaluation result v1",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "scenario_id",
    "scenario_revision",
    "scenario_digest",
    "host",
    "host_version",
    "adapter",
    "adapter_version",
    "model",
    "model_version",
    "status",
    "assertions",
    "started_at",
    "duration_ms",
    "usage",
    "evidence",
    "error",
    "digest"
  ],
  "properties": {
    "schema": { "const": "eval-result/v1" },
    "run_id": { "type": "string" },
    "scenario_id": { "type": "string" },
    "scenario_revision": { "type": "integer" },
    "scenario_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "host": { "type": "string" },
    "host_version": { "type": "string" },
    "adapter": { "type": "string" },
    "adapter_version": { "type": "integer" },
    "model": { "type": ["string", "null"] },
    "model_version": { "type": ["string", "null"] },
    "status": { "enum": ["passed", "failed", "blocked", "skipped", "incomplete", "error"] },
    "assertions": { "type": "array" },
    "usage": { "type": "object" },
    "evidence": { "type": "array" },
    "error": { "type": "object" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
