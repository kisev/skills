{
  "name": "@kisev/taskmatic",
  "version": "12.0.1",
  "description": "Local-first task board: SQLite, CLI, MCP, Markdown exports and a read-only web viewer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kisev/skills.git",
    "directory": "apps/taskmatic"
  },
  "bin": {
    "taskmatic": "./dist/cli.js",
    "taskmatic-web": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "README.ru.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc --project tsconfig.json",
    "test": "node --test test/",
    "pack:check": "node test/pack-allowlist.mjs"
  },
  "dependencies": {
    "@kisev/safe-fs": "^12.0.1",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
