---
import Base from "../layouts/Base.astro";
import { useUi } from "../i18n/ui";
import { localizedPath } from "../i18n/utils";

const t = useUi("en");
---

<Base locale="en" title={t.notFound.title} description={t.notFound.lead} hideLocaleSwitch>
  <h1>{t.notFound.title}</h1>
  <p class="lead">{t.notFound.lead}</p>
  <div class="actions">
    <a class="button primary" href={localizedPath("/", "en")}>{t.notFound.home}</a>
  </div>
</Base>
