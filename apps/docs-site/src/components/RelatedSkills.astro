---
import { useUi, type Locale } from "../i18n/ui";
import { localizedPath } from "../i18n/utils";
import relationReasonsRu from "../i18n/relation-reasons.ru.json";
import { catalog, type RelationEntry } from "../generated/skills";

interface Props {
  name: string;
  locale: Locale;
}

const { name, locale } = Astro.props;
const t = useUi(locale);
const reasons = relationReasonsRu as Record<string, string>;
const reasonText = (relation: RelationEntry) =>
  locale === "ru"
    ? (reasons[`${relation.from}|${relation.to}|${relation.type}`] ?? relation.reason)
    : relation.reason;
const related = catalog.relations.filter(
  (relation: RelationEntry) => relation.from === name || relation.to === name,
);
const labels = {
  requires: t.relations.requires,
  uses: t.relations.uses,
  recommends: t.relations.recommends,
} as const;
---

{
  related.length > 0 && (
    <section>
      <h2>{t.skillPage.relationsTitle}</h2>
      <dl class="relations">
        {(["requires", "uses", "recommends"] as const).map((type) => {
          const group = related.filter((relation: RelationEntry) => relation.type === type);
          return (
            group.length > 0 && (
              <>
                <dt>{labels[type]}</dt>
                {group.map((relation: RelationEntry) => {
                  const other = relation.from === name ? relation.to : relation.from;
                  return (
                    <dd>
                      <a href={localizedPath(`/skills/${other}/`, locale)}>{other}</a>
                      {relation.reason !== "" && <span> — {reasonText(relation)}</span>}
                    </dd>
                  );
                })}
              </>
            )
          );
        })}
      </dl>
    </section>
  )
}
